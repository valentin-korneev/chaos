{{ prefix }}LOG__LEVEL=INFO
{{ prefix }}LOG__FORMAT='%(asctime)s %(levelname)s %(name)s %(message)s'
{{ prefix }}LOG__DATE_FORMAT='%Y-%m-%d %H:%M:%S'
{% if api %}
{{ prefix }}PORT=8000
{% endif %}
{% if database %}
{{ prefix }}DB_HOST=db
{{ prefix }}DB_PORT=5432
{{ prefix }}DB_NAME={{ name }}
{{ prefix }}DB_USER=app
{{ prefix }}DB_PASSWORD={{ postgres_password or 'local-development' }}

POSTGRES_DB={{ '$' ~ '{' ~ prefix ~ 'DB_NAME}' }}
POSTGRES_USER={{ '$' ~ '{' ~ prefix ~ 'DB_USER}' }}
POSTGRES_PASSWORD={{ '$' ~ '{' ~ prefix ~ 'DB_PASSWORD}' }}
{% endif %}
{% if oidc %}
{{ prefix }}OIDC__DISCOVERY_URL=https://id.example.com/.well-known/openid-configuration
{{ prefix }}OIDC__CLIENT_ID=
{{ prefix }}OIDC__CLIENT_SECRET=
{% endif %}
