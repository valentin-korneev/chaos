{{ include_when(enabled=database) -}}
services:
  db:
    image: {{ postgres_image }}
    env_file: .env
    ports:
      - "5432:5432"
    volumes:
      - postgres_{{ name }}:/var/lib/postgresql
      - ./postgres/init.sql:/docker-entrypoint-initdb.d/init.sql:ro
    healthcheck:
      test: ['CMD-SHELL', 'pg_isready -h 127.0.0.1 -U "$${POSTGRES_USER}" -d "$${POSTGRES_DB}"']
      interval: 3s
      timeout: 3s
      retries: 10

  app:
    build: .
    env_file: .env
    depends_on:
      db:
        condition: service_healthy
{% if api %}
    ports:
      - "{{ '${' ~ prefix ~ 'PORT}' }}:{{ '${' ~ prefix ~ 'PORT}' }}"
{% endif %}
volumes:
  postgres_{{ name }}: null
