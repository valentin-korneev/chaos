"""Проверки настроек формата логов."""

from unittest.mock import Mock

import pytest

from {{ module }}.core import logging as project_logging
from {{ module }}.core.settings.log import LogSettings


def test_log_format(monkeypatch: pytest.MonkeyPatch) -> None:
    """Передать формат сообщения и даты из окружения в logging."""
    monkeypatch.setenv('{{ prefix }}LOG__FORMAT', '%(levelname)s: %(message)s')
    monkeypatch.setenv('{{ prefix }}LOG__DATE_FORMAT', '%H:%M:%S')
    configure = Mock()
    monkeypatch.setattr(project_logging, 'dictConfig', configure)

    project_logging.configure_logging(LogSettings())

    config = configure.call_args.args[0]
    assert config['formatters']['default'] == {
        'format': '%(levelname)s: %(message)s',
        'datefmt': '%H:%M:%S',
    }
