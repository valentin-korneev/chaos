"""Проверки входа и защиты API через OIDC."""

from http import HTTPStatus

import httpx2
import pytest
from fastapi.testclient import TestClient

from {{ module }}.routes.auth import oidc as auth


def test_info_requires_token(client: TestClient) -> None:
    """Проверить, что для сведений о проекте требуется токен."""
    assert client.get('/info').status_code == HTTPStatus.UNAUTHORIZED
    docs = client.get('/docs')
    assert docs.status_code == HTTPStatus.OK
    assert 'usePkceWithAuthorizationCodeGrant' in docs.text
    assert 'test-value' not in docs.text


def test_authorize(client: TestClient, monkeypatch: pytest.MonkeyPatch) -> None:
    """Проверить адрес входа из метаданных и параметры PKCE."""
    discovery_url = 'https://id.example.com/tenant/.well-known/openid-configuration'
    exchange_url = 'https://id.example.com/codes/redeem'

    def discovery(url: str, *, timeout: int, follow_redirects: bool) -> httpx2.Response:
        assert url == discovery_url
        assert timeout > 0
        assert not follow_redirects
        return httpx2.Response(
            HTTPStatus.OK,
            request=httpx2.Request('GET', url),
            json={
                'issuer': 'https://id.example.com/tenant',
                'authorization_endpoint': 'https://id.example.com/login/start?tenant=test',
                'token_endpoint': exchange_url,
                'jwks_uri': 'https://id.example.com/signing/keys.json',
            },
        )

    auth.provider_metadata.cache_clear()
    monkeypatch.setattr(httpx2, 'get', discovery)
    response = client.get(
        '/auth/authorize',
        params={
            'redirect_uri': 'http://testserver/docs/oauth2-redirect',
            'state': 'test-state',
            'code_challenge': 'a' * 43,
        },
        follow_redirects=False,
    )
    assert response.status_code == HTTPStatus.TEMPORARY_REDIRECT
    location = response.headers['location']
    assert location.startswith('https://id.example.com/login/start?')
    assert 'tenant=test' in location
    assert 'client_id=test-client' in location
    assert 'code_challenge_method=S256' in location
