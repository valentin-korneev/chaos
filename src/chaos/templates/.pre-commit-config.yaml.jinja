default_install_hook_types: [pre-commit, post-commit]
repos:
  - repo: local
    hooks:
      - id: bandit
        name: Bandit
        entry: uv run --locked bandit -r . -c pyproject.toml
        language: system
        pass_filenames: false
        always_run: true
        stages: [pre-commit]
      - id: ruff-errors
        name: Ошибки Ruff
        entry: uv run --locked ruff check --select E9,F .
        language: system
        pass_filenames: false
        always_run: true
        stages: [pre-commit]
      - id: bump-version
        name: Повышение patch-версии
        entry: uv version --bump patch --no-sync
        language: system
        pass_filenames: false
        always_run: true
        stages: [post-commit]
      - id: amend-version
        name: Добавление версии в коммит
        entry: >-
          sh -ec 'git -c "core.hooksPath=$(git rev-parse --absolute-git-dir)/no-hooks"
          commit --amend --only --no-edit -- pyproject.toml uv.lock'
        language: system
        pass_filenames: false
        always_run: true
        stages: [post-commit]
