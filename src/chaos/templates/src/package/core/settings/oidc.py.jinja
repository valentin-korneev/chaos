"""Параметры провайдера OIDC."""

from typing import Literal

from pydantic import BaseModel, Field, HttpUrl, SecretStr, field_validator


class OIDCSettings(BaseModel):
    """Параметры конфиденциального OIDC-клиента."""

    client_id: str = Field(min_length=1)
    client_secret: SecretStr = Field(min_length=1)
    discovery_url: HttpUrl
    signing_algorithm: Literal[
        'RS256', 'RS384', 'RS512', 'ES256', 'ES384', 'ES512', 'PS256', 'PS384', 'PS512',
    ] = 'RS256'
    token_auth_method: Literal['client_secret_basic', 'client_secret_post'] | None = None
    jwt_profile: Literal['rfc9068', 'keycloak'] = 'rfc9068'

    @field_validator('discovery_url')
    @classmethod
    def validate_discovery_url(cls, url: HttpUrl) -> HttpUrl:
        """Разрешить загрузку метаданных только по HTTPS."""
        if url.scheme != 'https' or url.username is not None or url.fragment is not None:
            message = 'Укажите HTTPS-адрес документа OIDC Discovery'
            raise ValueError(message)
        return url
